# Override this only if your public key is stored elsewhere.
ssh_public_key_path = "~/.ssh/id_ed25519.pub"
vm_user             = "ubuntu"

# Dedicated Terraform-managed NAT network and stable DHCP reservations.
libvirt_network      = "k8s-lab"
libvirt_network_cidr = "192.168.125.0/24"

mac_address          = "52:54:00:12:34:56"
control_plane_ip_host = 10

worker_mac_address = "52:54:00:12:34:57"
worker_ip_host     = 11
